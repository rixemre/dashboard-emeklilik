  if (STATE.activeTab === 'bes') return renderBesTab();
  if (STATE.activeTab === 'maliGelir') return renderFinancialTab();
  if (STATE.activeTab === 'gider') return renderExpenseTab();
  if (STATE.activeTab === 'karsilastirmali') return renderComparisonTab();
  return renderOverviewTab();
}

function normalizeTabKey(tabKey) {
  return ['ozet', 'hayat', 'bes', 'maliGelir', 'gider', 'karsilastirmali'].includes(tabKey) ? tabKey : 'ozet';
}

window.__setTab = function(tabKey) {
  const nextTab = normalizeTabKey(tabKey);
  STATE.activeTab = nextTab;
  if (window.location && window.location.hash !== `#${nextTab}`) {
    try {
      window.history.replaceState(null, '', `#${nextTab}`);
    } catch (error) {
      window.location.hash = nextTab;
    }
  }
  renderApp();
};

function renderApp() {
  const root = document.getElementById('app');
  root.innerHTML = `
    ${renderHero()}
    ${renderTabNav()}
    <main class="tab-content">${renderActiveTab()}</main>
  `;
}


function ensureComparisonTooltip() {
  let tooltip = document.querySelector('.comparison-tooltip');
  if (!tooltip) {
    tooltip = document.createElement('div');
    tooltip.className = 'comparison-tooltip';
    tooltip.innerHTML = '<div class="comparison-tooltip-title" data-tooltip-title></div><div class="comparison-tooltip-value" data-tooltip-value></div><div class="comparison-tooltip-meta" data-tooltip-meta></div>';
    document.body.appendChild(tooltip);
  }
  return tooltip;
}

function hideComparisonTooltip() {
  const tooltip = document.querySelector('.comparison-tooltip');
  if (tooltip) tooltip.classList.remove('show');
}

function moveComparisonTooltip(event, tooltip) {
  tooltip.style.left = `${event.clientX}px`;
  tooltip.style.top = `${event.clientY}px`;
}

document.addEventListener('mousemove', (event) => {
  const target = event.target.closest ? event.target.closest('[data-comparison-tooltip]') : null;
  if (!target) {
    hideComparisonTooltip();
    return;
  }
  const tooltip = ensureComparisonTooltip();
  tooltip.querySelector('[data-tooltip-title]').textContent = target.getAttribute('data-tooltip-title') || '';
  tooltip.querySelector('[data-tooltip-value]').textContent = target.getAttribute('data-tooltip-value') || '';
  tooltip.querySelector('[data-tooltip-meta]').textContent = target.getAttribute('data-tooltip-meta') || '';
  moveComparisonTooltip(event, tooltip);
  tooltip.classList.add('show');
});

document.addEventListener('mouseleave', hideComparisonTooltip);


function getTableSortRawText(cell) {
  if (!cell) return '';
  const clone = cell.cloneNode(true);
  clone.querySelectorAll('.sort-arrow, .dot').forEach((node) => node.remove());
  return clone.textContent.replace(/\s+/g, ' ').trim();
}

function parseTableSortValue(text) {
  const raw = String(text || '').trim();
  const lower = raw.toLocaleLowerCase('tr-TR');
  if (!raw || lower === 'n/a' || lower === 'na' || lower === '-' || lower === '—') {
    return { type: 'empty', value: null, text: raw };
  }

  // Finansal tablo formatı: negatif değerler "(x)" olarak gösterilir.
  // Sıralamada bu değerleri mutlak büyüklük gibi değil, gerçek negatif değer gibi ele al.
  const accountingNegative = /\([^)]*\d[^)]*\)/.test(raw);
  const numericMatch = raw.match(/[+-]?\s*\d+(?:[.,]\d+)?/);
  if (numericMatch) {
    let value = Number(numericMatch[0].replace(/\s+/g, '').replace(',', '.'));
    if (Number.isFinite(value)) {
      if (accountingNegative) value = -Math.abs(value);
      if (lower.includes('tri')) value *= 1000;
      else if (lower.includes('mia')) value *= 1;
      else if (lower.includes('mio')) value *= 0.001;
      return { type: 'number', value, text: raw };
    }
  }
  return { type: 'text', value: lower, text: raw };
}

function compareTableCells(aCell, bCell, direction) {
  const a = parseTableSortValue(getTableSortRawText(aCell));
  const b = parseTableSortValue(getTableSortRawText(bCell));
  const sign = direction === 'asc' ? 1 : -1;
  if (a.type === 'empty' && b.type !== 'empty') return 1;
  if (b.type === 'empty' && a.type !== 'empty') return -1;
  if (a.type === 'number' && b.type === 'number') return (a.value - b.value) * sign;
  return String(a.text).localeCompare(String(b.text), 'tr') * sign;
}

function applyTableHeaderSortState(table, header, direction) {
  table.querySelectorAll('thead th').forEach((th) => {
    th.classList.remove('sorted', 'active');
    th.setAttribute('aria-sort', 'none');
    th.querySelectorAll('.sort-arrow').forEach((node) => node.remove());
  });
  header.classList.add('sorted');
  header.setAttribute('aria-sort', direction === 'asc' ? 'ascending' : 'descending');
  const arrow = document.createElement('span');
  arrow.className = 'sort-arrow';
  arrow.textContent = direction === 'asc' ? '↑' : '↓';
  header.appendChild(arrow);
}

function sortDataTableByHeader(header) {
  const table = header.closest('table');
  const tbody = table?.querySelector('tbody');
  if (!table || !tbody) return;
  const headers = Array.from(header.parentElement.children);
  const index = headers.indexOf(header);
  if (index < 0) return;
  const previousIndex = Number(table.dataset.sortColumnIndex);
  const previousDirection = table.dataset.sortDirection || '';
  const direction = previousIndex === index && previousDirection === 'desc' ? 'asc' : 'desc';
  const rows = Array.from(tbody.querySelectorAll('tr'));
  rows.sort((a, b) => compareTableCells(a.children[index], b.children[index], direction));
  rows.forEach((row) => tbody.appendChild(row));
  table.dataset.sortColumnIndex = String(index);
  table.dataset.sortDirection = direction;
  applyTableHeaderSortState(table, header, direction);
}

document.addEventListener('click', (event) => {
  const sortableHeader = event.target.closest('.data-table thead th');
  if (sortableHeader) {
    event.preventDefault();
    sortDataTableByHeader(sortableHeader);
    return;
  }
  const tab = event.target.closest('[data-tab]');
  if (tab) {
    event.preventDefault();
    window.__setTab(tab.getAttribute('data-tab'));
    return;
  }
  const compareAction = event.target.closest('[data-compare-action]');
  if (compareAction) {
    handleComparisonAction(compareAction.getAttribute('data-compare-action'));
    renderApp();
    return;
  }
  const compareToggle = event.target.closest('[data-compare-toggle]');
  if (compareToggle) {
    toggleComparisonCompany(compareToggle.getAttribute('data-compare-toggle'));
    renderApp();
    return;
  }
  const row = event.target.closest('[data-company]');
  if (row) {
    STATE.selectedCompany = row.getAttribute('data-company');
    renderApp();
    return;
  }
  const lifeView = event.target.closest('[data-life-view]');
  if (lifeView) {
    STATE.lifeTableView = lifeView.getAttribute('data-life-view');
    renderApp();
    return;
  }
  const finAssetView = event.target.closest('[data-fin-asset-view]');
  if (finAssetView) {
    STATE.financialAssetTableView = finAssetView.getAttribute('data-fin-asset-view');
    renderApp();
    return;
  }
});

document.addEventListener('change', (event) => {
  if (event.target.matches('[data-role="company-picker"]')) {
    STATE.selectedCompany = event.target.value;
    renderApp();
  }
});

window.addEventListener('hashchange', () => {
  const hashTab = normalizeTabKey((window.location.hash || '').replace('#', ''));
  if (hashTab !== STATE.activeTab) {
    STATE.activeTab = hashTab;
    renderApp();
  }
});

document.addEventListener('DOMContentLoaded', () => {
  const hashTab = normalizeTabKey((window.location.hash || '').replace('#', ''));
  STATE.activeTab = hashTab;
  renderApp();
});
</script>
</body>
</html>
