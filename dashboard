function radarPlainComment(row) {
  const metric = normalizeSignalText(row.metric);
  const title = normalizeSignalText(row.title);
  if (row.impact === 'scope') return '2026 datasında karşılığı olmadığı için toplam/ortalama yorumlarında ayrı gösterilmeli.';
  if (metric.includes('net') && title.includes('en büyük')) return 'Kâr artışı yüksek; teknik sonuç, mali gelir ve ölçek etkisi ayrı okunmalı.';
  if (metric.includes('net') && title.includes('%')) return 'Yüzdesel sıçrama düşük baz etkisi içerebilir; sürdürülebilirlik kontrol edilmeli.';
  if (title.includes('zarardan')) return 'Pozitif dönüş dikkat çekiyor; tek seferlik etki mi operasyonel iyileşme mi ayrıştırılmalı.';
  if (metric.includes('fig') && Number(row.delta) >= 0) return 'Fon işletim gelirinin teknik gelirdeki payı artmış; BES gelir kalitesi açısından olumlu.';
  if (metric.includes('fig')) return 'Fon işletim gelirinin payı azalmış; teknik gelir kompozisyonu kontrol edilmeli.';
  if (metric.includes('komisyon') && Number(row.delta) >= 0) return 'Komisyon / teknik gelir oranı artmış; kanal maliyeti ve yeni iş hacmi birlikte incelenmeli.';
  if (metric.includes('komisyon')) return 'Komisyon / teknik gelir oranı gerilemiş; dağıtım maliyeti daha kontrollü görünüyor.';
  return row.reason || 'İlgili metrik kırılımı incelenmeli.';
}

