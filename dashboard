function formatSignedPoint(value) {
  const num = Number(value);
  if (!Number.isFinite(num)) return 'n/a';
  const text = `${Math.abs(num).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })} puan`;
  if (num > 0) return `+${text}`;
  if (num < 0) return `(${text})`;
  return text;
}

function formatExtremeValue(row, key) {
  const value = row[key];
  if (!hasComparableValue(value)) return 'Yok';
  if (row.unit === 'pp') return formatPct(value);
  return formatBn(value);
}

function formatExtremeDelta(row) {
  if (row.status) return row.status;
  if (!hasComparableValue(row.delta)) return 'n/a';
  if (row.unit === 'pp') return formatSignedPoint(row.delta);
  return `${formatSignedBn(row.delta)}${hasComparableValue(row.deltaPct) ? ` · ${formatSignedPct(row.deltaPct)}` : ''}`;
}

function extremeImpactLabel(impact) {
  if (impact === 'positive') return 'Olumlu';
  if (impact === 'risk') return 'Risk';
  if (impact === 'scope') return 'Kapsam';
  return 'İzle';
}

function extremeDeltaClass(row) {
  if (row.impact === 'scope') return 'scope';
  if (hasComparableValue(row.delta) && Number(row.delta) < 0) return 'risk';
  return row.impact === 'risk' ? 'risk' : 'positive';
}


function normalizeSignalText(value) {
  return String(value || '').toLocaleLowerCase('tr-TR').normalize('NFD').replace(/[\u0300-\u036f]/g, '');
}

function extremeCategoryKey(row) {
  const metric = normalizeSignalText(row.metric);
  if (row.impact === 'scope') return 'scope';
  if (metric.includes('net')) return 'profit';
  if (metric.includes('fig')) return 'fig';
  if (metric.includes('komisyon') || metric.includes('marj')) return 'besQuality';
  return 'other';
}

function extremeCategoryMeta(key) {
  const map = {
    profit: {
      order: '01',
      title: 'Kârlılık sinyalleri',
      desc: 'Net kâr seviyesi, sıçrama ve zarardan kâra dönüş hareketleri.'
    },
    fig: {
      order: '02',
      title: 'BES gelir kompozisyonu',
      desc: 'Fon işletim gelirinin BES teknik gelir içindeki payı.'
    },
    besQuality: {
      order: '03',
      title: 'BES komisyon oranı',
      desc: 'Komisyon giderinin BES teknik gelire oranındaki anlamlı değişimler.'
    },
    scope: {
      order: '04',
      title: 'Kapsam notları',
      desc: 'Bir yılda olup diğer yılda olmayan şirketler ve karşılaştırma kapsamı.'
    },
    other: {
      order: '05',
      title: 'Diğer sinyaller',
      desc: 'Ek inceleme gerektiren diğer YoY hareketleri.'
    }
  };
  return map[key] || map.other;
}

function extremeActionText(row) {
  if (row.impact === 'scope') return 'Karşılaştırma kapsamı ayrıca not edilmeli; toplam/ortalama yorumuna dahil ederken dikkat edilmeli.';
  const metric = normalizeSignalText(row.metric);
  const title = normalizeSignalText(row.title);
  if (metric.includes('net') && title.includes('en büyük')) return 'Teknik sonuç, mali gelir ve ölçek etkisi ayrı ayrı kontrol edilmeli.';
  if (metric.includes('net') && title.includes('%')) return 'Düşük baz etkisi ayrıştırılmalı; artışın sürdürülebilirliği kontrol edilmeli.';
  if (title.includes('zarardan')) return 'Dönüşümün tek seferlik mi operasyonel mi olduğu incelenmeli.';
  if (metric.includes('fig')) return 'Fon işletim geliri, yönetim gideri kesintisi ve teknik gelir kompozisyonu birlikte okunmalı.';
  if (metric.includes('komisyon')) return 'Banka/acente kanal kırılımı, yeni iş hacmi ve teknik gelir büyümesi birlikte okunmalı.';
  if (metric.includes('marj')) return 'Teknik gelir baz etkisi ve gider kontrolü ayrıştırılmalıdır.';
  return row.reason || 'İlgili metrik kırılımı detaylı incelenmelidir.';
}

