<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>TSB 1Ç26 Dashboard - Standalone HTML</title>
  <style>
:root {
  --bg: #f3f6fb;
  --card: #ffffff;
  --text: #0f172a;
  --muted: #64748b;
  --line: #dbe4ee;
  --shadow: 0 18px 48px rgba(15, 23, 42, 0.08);
  --radius: 28px;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--bg); color: var(--text); font-family: Inter, Arial, sans-serif; }
body { min-height: 100vh; }
button, select { font: inherit; }
button { cursor: pointer; }
#app { max-width: 1500px; margin: 0 auto; padding: 24px; display: grid; gap: 24px; }
.hero { position: relative; overflow: hidden; border-radius: 32px; padding: 24px; color: #fff; background: radial-gradient(circle at 15% 20%, rgba(255,255,255,0.16), transparent 28%), linear-gradient(135deg, #05070a 0%, #0f172a 55%, #020617 100%); box-shadow: 0 24px 60px rgba(2, 6, 23, 0.35); }
.hero::before { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 80% 20%, color-mix(in srgb, var(--accent) 50%, transparent), transparent 28%); opacity: 0.9; pointer-events: none; }
.hero-top, .hero-grid { position: relative; z-index: 1; }
.hero-top { display: flex; gap: 16px; justify-content: space-between; align-items: center; flex-wrap: wrap; }
.hero-kicker { display: inline-flex; align-items: center; gap: 8px; padding: 8px 12px; border-radius: 999px; background: rgba(255,255,255,0.1); font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; }
.hero-meta { display: flex; flex-wrap: wrap; gap: 12px; font-size: 12px; color: rgba(255,255,255,0.76); }
.hero-grid { margin-top: 18px; display: grid; gap: 20px; grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr); }
.hero h1 { margin: 0; font-size: clamp(30px, 4vw, 46px); line-height: 1.05; letter-spacing: -0.04em; }
.hero p { margin: 14px 0 0; max-width: 860px; line-height: 1.7; color: rgba(255,255,255,0.82); }
.hero-kpis { display: grid; gap: 12px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
.hero-kpi { border: 1px solid rgba(255,255,255,0.12); border-radius: 22px; padding: 16px; background: rgba(255,255,255,0.08); backdrop-filter: blur(10px); }
.hero-kpi-label { font-size: 11px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(255,255,255,0.65); }
.hero-kpi-value { margin-top: 10px; font-size: 26px; font-weight: 800; letter-spacing: -0.04em; color: #f8fafc; }
.hero-kpi-detail { margin-top: 8px; font-size: 13px; color: rgba(255,255,255,0.74); }
.tab-nav { position: relative; z-index: 60; isolation: isolate; display: flex; flex-wrap: wrap; gap: 10px; padding: 10px; border-radius: 24px; background: #05070a; box-shadow: 0 18px 48px rgba(2, 6, 23, 0.18); pointer-events: auto; }
.tab-btn { position: relative; z-index: 61; min-width: 136px; display: inline-flex; align-items: center; gap: 12px; padding: 12px 16px; border: 1px solid #1e293b; border-radius: 18px; background: #0b111a; color: #cbd5e1; transition: 0.2s ease; pointer-events: auto; }
.tab-btn:hover { transform: translateY(-1px); border-color: #334155; color: #fff; }
.tab-btn.active { background: linear-gradient(135deg, #111827 0%, #0f172a 100%); color: #fff; border-color: rgba(251, 191, 36, 0.75); box-shadow: 0 18px 36px rgba(37, 99, 235, 0.18); }
.tab-code { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 10px; background: rgba(148,163,184,0.16); font-size: 11px; font-weight: 800; }
.tab-btn.active .tab-code { background: #fbbf24; color: #111827; }
.tab-label { font-weight: 700; }
.tab-content { display: grid; gap: 24px; }
.grid { display: grid; gap: 24px; }
.two-col { grid-template-columns: repeat(2, minmax(0, 1fr)); }
.metrics-grid { gap: 16px; }
.metrics-grid.four { grid-template-columns: repeat(4, minmax(0, 1fr)); }
.metrics-grid.five { grid-template-columns: repeat(5, minmax(0, 1fr)); }
.metrics-grid.six { grid-template-columns: repeat(6, minmax(0, 1fr)); }
.card { background: var(--card); border: 1px solid rgba(148, 163, 184, 0.22); border-radius: var(--radius); padding: 20px; box-shadow: var(--shadow); }
.card.inner-card { background: #f8fafc; box-shadow: none; }
.section-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; }
.section-head.spread { align-items: flex-start; }
.section-head h2 { margin: 0; font-size: 20px; letter-spacing: -0.02em; }
.section-head p { margin: 6px 0 0; color: var(--muted); line-height: 1.6; }
.metric-card { min-height: 170px; border-radius: 28px; padding: 18px; box-shadow: var(--shadow); position: relative; overflow: hidden; }
.metric-card::before { content: ''; position: absolute; inset: auto -32px -32px auto; width: 100px; height: 100px; border-radius: 999px; background: rgba(255,255,255,0.12); }
.metric-card.slate { background: linear-gradient(135deg, #020617 0%, #0f172a 56%, #111827 100%); color: #fff; }
.metric-card.blue { background: linear-gradient(135deg, #1d4ed8 0%, #2563eb 58%, #1e3a8a 100%); color: #fff; }
.metric-card.emerald { background: linear-gradient(135deg, #047857 0%, #059669 58%, #065f46 100%); color: #fff; }
.metric-card.amber { background: linear-gradient(135deg, #f59e0b 0%, #f97316 58%, #d97706 100%); color: #111827; }
.metric-card.white { background: linear-gradient(135deg, #ffffff 0%, #f8fafc 58%, #eef2ff 100%); color: #0f172a; border: 1px solid rgba(148,163,184,0.24); }
.metric-label { position: relative; z-index: 1; font-size: 11px; font-weight: 800; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.75; }
.metric-value { position: relative; z-index: 1; margin-top: 18px; font-size: 30px; font-weight: 800; letter-spacing: -0.04em; line-height: 1.05; }
.metric-subtitle { position: relative; z-index: 1; margin-top: 16px; line-height: 1.6; opacity: 0.84; }
.picker {
  display: inline-grid;
  gap: 10px;
  margin-top: 12px;
  width: min(100%, 460px);
  padding: 12px;
  border-radius: 22px;
  border: 1px solid rgba(37, 99, 235, 0.20);
  background: linear-gradient(135deg, #f8fbff 0%, #eef6ff 100%);
  box-shadow: 0 14px 34px rgba(15, 23, 42, 0.07);
}
.picker-title {
  display: flex;
  align-items: center;
  gap: 9px;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: #1e3a8a;
}
.picker-icon {
  display: inline-grid;
  place-items: center;
  width: 24px;
  height: 24px;
  border-radius: 9px;
  background: #2563eb;
  color: #fff;
  font-size: 13px;
  letter-spacing: 0;
  box-shadow: 0 10px 22px rgba(37, 99, 235, 0.26);
}
.picker-hint {
  margin-left: auto;
  padding: 5px 9px;
  border-radius: 999px;
  background: #dbeafe;
  color: #1d4ed8;
  font-size: 10px;
  font-style: normal;
  font-weight: 900;
  letter-spacing: 0.10em;
}
.picker-control {
  position: relative;
  display: block;
}
.picker select {
  width: 100%;
  appearance: none;
  -webkit-appearance: none;
  padding: 14px 48px 14px 16px;
  border-radius: 16px;
  border: 1px solid rgba(37, 99, 235, 0.36);
  background: #fff;
  color: #0f172a;
  font-weight: 800;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,0.85), 0 10px 22px rgba(37, 99, 235, 0.08);
  transition: 0.18s ease;
}
.picker select:hover, .picker select:focus {
  border-color: #2563eb;
  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.13), 0 16px 30px rgba(37, 99, 235, 0.12);
  outline: none;
}
.picker-arrow {
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  width: 28px;
  height: 28px;
  display: grid;
  place-items: center;
  border-radius: 999px;
  background: #0f172a;
  color: white;
  font-size: 15px;
  pointer-events: none;
}
@media (max-width: 640px) {
  .picker { width: 100%; }
  .picker-hint { display: none; }
}
.selected-hero { margin-top: 18px; border-radius: 28px; padding: 18px; color: white; display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
.selected-kicker { font-size: 11px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.72); }
.selected-title { margin-top: 8px; font-size: 28px; font-weight: 800; letter-spacing: -0.04em; }
.selected-tags { margin-top: 12px; display: flex; gap: 8px; flex-wrap: wrap; }
.selected-subtitle { margin-top: 12px; max-width: 720px; color: rgba(255,255,255,0.82); line-height: 1.6; }
.badge { display: inline-flex; align-items: center; gap: 8px; padding: 7px 10px; border-radius: 999px; font-size: 12px; font-weight: 700; white-space: nowrap; }
.badge.ghost { background: rgba(255,255,255,0.14); color: white; }
.badge.slate { background: #0f172a; color: white; }
.badge.emerald { background: #ecfdf5; color: #047857; }
.badge.rose { background: #fff1f2; color: #be123c; }
.badge.amber { background: #fff7ed; color: #b45309; }
.mini-metric { border-radius: 22px; padding: 14px; border: 1px solid var(--line); background: #fff; }
.mini-metric.slate { background: #f8fafc; }
.mini-metric.blue { background: #eff6ff; }
.mini-metric.emerald { background: #ecfdf5; }
.mini-metric.rose { background: #fff1f2; }
.mini-metric.amber { background: #fff7ed; }
.mini-label { font-size: 12px; color: var(--muted); }
.mini-value { margin-top: 8px; font-size: 22px; font-weight: 800; letter-spacing: -0.03em; }
.bar-list { display: grid; gap: 12px; margin-top: 8px; }
.bar-list.compact { gap: 10px; }
.bar-row { border: 0; padding: 0; background: none; text-align: left; }
.bar-row.selectable { cursor: pointer; }
.bar-meta { display: flex; justify-content: space-between; gap: 12px; align-items: center; }
.bar-label-wrap { display: flex; align-items: center; gap: 10px; min-width: 0; }
.dot { width: 10px; height: 10px; border-radius: 999px; flex: 0 0 10px; }
.brand-mark {
  --brand: #0f172a;
  --brand-text: #fff;
  display: inline-grid;
  place-items: center;
  flex: 0 0 auto;
  width: 27px;
  height: 27px;
  border-radius: 10px;
  background: linear-gradient(135deg, color-mix(in srgb, var(--brand) 90%, #ffffff 10%), var(--brand));
  color: var(--brand-text);
  border: 1px solid rgba(255,255,255,0.80);
  box-shadow: 0 10px 22px rgba(15,23,42,0.14), inset 0 1px 0 rgba(255,255,255,0.28);
  font-size: 9px;
  font-weight: 950;
  letter-spacing: -0.03em;
  line-height: 1;
  text-transform: uppercase;
  overflow: hidden;
}
.brand-mark.xs { width: 23px; height: 23px; border-radius: 8px; font-size: 8px; }
.brand-mark.sm { width: 27px; height: 27px; border-radius: 10px; font-size: 9px; }
.brand-mark.lg { width: 42px; height: 42px; border-radius: 15px; font-size: 12px; box-shadow: 0 18px 36px rgba(15,23,42,0.22), inset 0 1px 0 rgba(255,255,255,0.36); }
.company-logo-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.sticky-name { gap: 9px; min-width: 260px; }
.bar-label-wrap { gap: 8px; }
.comparison-company-cell, .radar-company { gap: 8px; }
.company-chip .brand-mark { width: 21px; height: 21px; border-radius: 8px; font-size: 7px; }
.selected-title { display: flex; align-items: center; gap: 12px; }
.selected-title .company-logo-name { color: inherit; }
.table-wrap .brand-mark { transform: translateZ(0); }

.bar-label { font-weight: 700; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.bar-value { font-weight: 800; color: #0f172a; white-space: nowrap; }
.bar-value.neg { color: #be123c; }
.bar-track { margin-top: 8px; height: 11px; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
.bar-fill { display: block; height: 100%; border-radius: 999px; }
.bar-subtitle { margin-top: 6px; font-size: 12px; color: var(--muted); }
.signal-box { border-radius: 24px; padding: 16px; border: 1px solid var(--line); }
.signal-box.emerald { background: #ecfdf5; border-color: #bbf7d0; }
.signal-box.rose { background: #fff1f2; border-color: #fecdd3; }
.signal-title { font-size: 15px; font-weight: 800; }
.signal-list { display: grid; gap: 10px; margin-top: 12px; }
.signal-item { display: flex; gap: 10px; background: rgba(255,255,255,0.85); border: 1px solid rgba(255,255,255,0.7); padding: 10px 12px; border-radius: 18px; line-height: 1.55; }
.signal-dot { width: 8px; height: 8px; border-radius: 999px; background: currentColor; margin-top: 8px; flex: 0 0 8px; }
.note { padding: 14px 16px; border-radius: 20px; background: #f8fafc; color: #475569; line-height: 1.7; }
.mt-16 { margin-top: 16px; }
.stack { display: grid; gap: 16px; }
.table-wrap { margin-top: 16px; overflow: auto; border: 1px solid var(--line); border-radius: 24px; background: #fff; }
.table-wrap.wide table { min-width: 1180px; }
.data-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.data-table.compact-table { font-size: 13px; }
.data-table thead th { position: sticky; top: 0; z-index: 1; background: #f8fafc; color: #64748b; text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px; text-align: right; padding: 12px 14px; border-bottom: 1px solid var(--line); }
.data-table thead th:first-child { text-align: left; }
.data-table thead th { cursor: pointer; user-select: none; transition: background 0.16s ease, color 0.16s ease, box-shadow 0.16s ease; }
.data-table thead th:hover { background: #eef2ff; color: #0f172a; }
.data-table thead th.sortable-th, .data-table thead th.sorted { cursor: pointer; user-select: none; }
.data-table thead th.sortable-th.active, .data-table thead th.sorted { color: #0f172a; background: #eef2ff; box-shadow: inset 0 -2px 0 rgba(37,99,235,0.42); }
.sort-arrow { margin-left: 6px; font-size: 10px; opacity: 0.75; }
.data-table tbody td, .data-table tfoot td { padding: 12px 14px; border-bottom: 1px solid #edf2f7; }
.data-table tfoot td { background: #0f172a; color: white; font-weight: 800; border-bottom: 0; }
.data-table td.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; font-weight: 700; }
.data-table td.num.neg { color: #be123c; }
.data-table td.num.good { color: #047857; }
.data-table td.bold-col, .data-table th.bold-col { font-weight: 900 !important; }
.sticky-name { min-width: 220px; white-space: nowrap; font-weight: 800; display: flex; align-items: center; gap: 10px; }
.select-row { cursor: pointer; }
.select-row.selected { background: rgba(37, 99, 235, 0.08); }
.select-row:hover { background: rgba(15, 23, 42, 0.04); }
.btn-row { display: flex; gap: 8px; flex-wrap: wrap; }
.pill-btn { border: 1px solid var(--line); background: #f8fafc; color: #334155; border-radius: 999px; padding: 10px 14px; font-size: 13px; font-weight: 700; }
.pill-btn:hover { background: #eef2ff; }
.pill-btn.active { background: #0f172a; color: white; border-color: #0f172a; }



.comparison-showcase {
  position: relative;
  overflow: hidden;
  border: 1px solid rgba(148, 163, 184, 0.14);
  color: #e5edf7;
  background:
    radial-gradient(circle at 9% -12%, rgba(96, 165, 250, 0.32), transparent 30%),
    radial-gradient(circle at 96% 2%, rgba(168, 85, 247, 0.28), transparent 30%),
    linear-gradient(135deg, #020617 0%, #07111f 42%, #111827 100%);
  box-shadow: 0 34px 90px rgba(2, 6, 23, 0.34);
}
.comparison-showcase::before {
  content: '';
  position: absolute;
  inset: 0;
  background:
    linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px),
    linear-gradient(180deg, rgba(255,255,255,0.028) 1px, transparent 1px);
  background-size: 52px 52px;
  mask-image: radial-gradient(circle at 50% 10%, black, transparent 76%);
  pointer-events: none;
}
.comparison-showcase::after {
  content: '';
  position: absolute;
  inset: 1px;
  border-radius: calc(var(--radius) - 1px);
  border: 1px solid rgba(255,255,255,0.08);
  pointer-events: none;
}
.comparison-clean-head { position: relative; z-index: 1; display: flex; justify-content: space-between; align-items: flex-start; gap: 18px; flex-wrap: wrap; }
.comparison-clean-title h2 { margin: 0; color: #f8fafc; font-size: 28px; letter-spacing: -0.055em; }
.comparison-clean-title p { margin: 7px 0 0; color: rgba(226, 232, 240, 0.68); line-height: 1.45; font-weight: 650; }
.comparison-legend { display: flex; flex-wrap: wrap; gap: 8px; justify-content: flex-end; }
.legend-pill { display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 999px; padding: 8px 12px; background: rgba(255,255,255,0.08); color: rgba(248,250,252,0.9); font-size: 12px; font-weight: 900; box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 14px 32px rgba(2,6,23,0.22); backdrop-filter: blur(14px); }
.legend-swatch { width: 18px; height: 10px; border-radius: 999px; display: inline-block; box-shadow: 0 0 0 1px rgba(255,255,255,0.12) inset; }
.comparison-kpi-strip { position: relative; z-index: 1; margin-top: 20px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
.comparison-kpi { position: relative; overflow: hidden; border-radius: 28px; padding: 18px 19px; background: rgba(255,255,255,0.082); border: 1px solid rgba(255,255,255,0.12); box-shadow: inset 0 1px 0 rgba(255,255,255,0.12), 0 22px 46px rgba(2,6,23,0.18); backdrop-filter: blur(16px); color: #f8fafc; }
.comparison-kpi::after { content: ''; position: absolute; inset: auto -28px -32px auto; width: 92px; height: 92px; border-radius: 999px; background: rgba(96,165,250,0.13); }
.comparison-kpi.dark { background: linear-gradient(135deg, rgba(37,99,235,0.95) 0%, rgba(79,70,229,0.90) 52%, rgba(15,23,42,0.92) 100%); border-color: rgba(147,197,253,0.30); box-shadow: 0 24px 58px rgba(37, 99, 235, 0.22); }
.comparison-kpi.positive { background: linear-gradient(135deg, rgba(4,120,87,0.88), rgba(15,23,42,0.86)); border-color: rgba(52,211,153,0.26); }
.comparison-kpi.negative { background: linear-gradient(135deg, rgba(159,18,57,0.88), rgba(15,23,42,0.86)); border-color: rgba(251,113,133,0.25); }
.comparison-kpi-label { position: relative; z-index: 1; color: rgba(226,232,240,0.66); font-size: 11px; font-weight: 950; letter-spacing: 0.14em; text-transform: uppercase; }
.comparison-kpi-value { position: relative; z-index: 1; margin-top: 10px; color: #ffffff; font-size: 27px; font-weight: 950; letter-spacing: -0.055em; }
.comparison-kpi-note { position: relative; z-index: 1; margin-top: 7px; color: rgba(226,232,240,0.62); font-size: 12px; font-weight: 800; }
.comparison-chart-card { position: relative; z-index: 1; margin-top: 18px; border-radius: 36px; border: 1px solid rgba(191, 219, 254, 0.48); background: linear-gradient(135deg, rgba(255,255,255,0.94), rgba(239,246,255,0.88)); padding: 14px; box-shadow: inset 0 1px 0 rgba(255,255,255,0.92), 0 30px 70px rgba(15, 23, 42, 0.16); backdrop-filter: blur(18px); }
.comparison-chart-scroll { overflow-x: auto; padding: 0 0 8px; border-radius: 30px; scrollbar-color: rgba(100,116,139,0.45) transparent; }
.comparison-svg { width: 100%; min-width: 1040px; display: block; border-radius: 30px; }
.svg-grid { stroke: rgba(15, 23, 42, 0.075); stroke-width: 1; }
.svg-zero { stroke: rgba(15, 23, 42, 0.34); stroke-width: 1.4; }
.svg-axis-label { fill: rgba(15, 23, 42, 0.56); font-size: 11px; font-weight: 850; }
.svg-year-label { fill: rgba(51, 65, 85, 0.72); font-size: 10px; font-weight: 950; letter-spacing: 0.08em; }
.svg-company-label-mini { fill: #0f172a; font-size: 12px; font-weight: 950; letter-spacing: -0.02em; }
.svg-delta-text { fill: #ffffff; font-size: 12px; font-weight: 950; letter-spacing: -0.01em; }
.svg-delta-subtext { fill: rgba(51, 65, 85, 0.78); font-size: 10px; font-weight: 900; }
.svg-missing-mini { fill: #b45309; font-size: 10px; font-weight: 950; }
.svg-company-panel { fill: rgba(255,255,255,0.72); stroke: rgba(148,163,184,0.26); stroke-width: 1; }
.svg-company-panel.alt { fill: rgba(248,250,252,0.86); }
.svg-delta-line { fill: none; stroke-width: 2.4; stroke-linecap: round; opacity: 0.72; }
.svg-bar { transition: opacity 0.16s ease, filter 0.16s ease, transform 0.16s ease; transform-box: fill-box; transform-origin: center bottom; }
.svg-bar-hover:hover .svg-bar { opacity: 0.98; filter: drop-shadow(0 12px 16px rgba(15, 23, 42, 0.22)); transform: scaleY(1.018); }
.svg-hit { cursor: pointer; }
.comparison-selector-shell { margin-top: 16px; padding: 16px; border-radius: 28px; background: rgba(255,255,255,0.075); border: 1px solid rgba(255,255,255,0.12); box-shadow: inset 0 1px 0 rgba(255,255,255,0.10); }
.selector-actions { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between; }
.selector-actions-left, .selector-actions-right { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
