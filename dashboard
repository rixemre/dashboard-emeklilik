function n(value) {
  const num = Number(value);
  return Number.isFinite(num) ? num : 0;
}

function round(value, digits = 3) {
  return Number(n(value).toFixed(digits));
}

function sum(items, selector) {
  return items.reduce((total, item) => total + n(selector(item)), 0);
}

function sortBy(items, selector, direction = 'desc') {
  const sign = direction === 'asc' ? 1 : -1;
  return [...items].sort((a, b) => (n(selector(a)) - n(selector(b))) * sign);
}

function escapeHtml(value) {
  return String(value ?? '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function hexToRgba(hex, alpha = 1) {
  const clean = String(hex || '').replace('#', '');
  if (clean.length !== 6) return `rgba(15,23,42,${alpha})`;
  const int = parseInt(clean, 16);
  const r = (int >> 16) & 255;
  const g = (int >> 8) & 255;
  const b = int & 255;
  return `rgba(${r}, ${g}, ${b}, ${alpha})`;
}

function getCompanyColor(item) {
  const key = typeof item === 'string' ? item : item?.company;
  return COMPANY_COLORS[key] || COMPANY_COLORS.__OTHER__;
}

function getContrastText(hex) {
  const clean = String(hex || '').replace('#', '');
  if (clean.length !== 6) return '#ffffff';
  const int = parseInt(clean, 16);
  const r = ((int >> 16) & 255) / 255;
  const g = ((int >> 8) & 255) / 255;
  const b = (int & 255) / 255;
  const toLinear = (c) => c <= 0.03928 ? c / 12.92 : Math.pow((c + 0.055) / 1.055, 2.4);
  const luminance = 0.2126 * toLinear(r) + 0.7152 * toLinear(g) + 0.0722 * toLinear(b);
  return luminance > 0.52 ? '#0f172a' : '#ffffff';
}

