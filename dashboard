  return `<td class="num ${cls} ${extraClass}">${escapeHtml(formatMaybePct(value))}</td>`;
}

function comparisonSortScore(item) {
  const v2025 = hasComparableValue(item.netIncome2025) ? Math.abs(n(item.netIncome2025)) : 0;
  const v2026 = hasComparableValue(item.netIncome2026) ? Math.abs(n(item.netIncome2026)) : 0;
  return Math.max(v2025, v2026);
}

function getComparisonRowsSorted() {
  return [...comparisonNetIncomeRows].sort((a, b) => {
    const statusDelta = (a.availability === 'both' ? 0 : 1) - (b.availability === 'both' ? 0 : 1);
    if (statusDelta !== 0) return statusDelta;
    return comparisonSortScore(b) - comparisonSortScore(a);
  });
}

function getComparisonDefaultSelection() {
  const preferred = [
