}

function calcCostIncomeRatioFromParts(parts) {
  if (!parts) return null;
  const expenseLoad = Math.abs(n(parts.expenseLoad));
  const periodProfit = n(parts.periodProfit);
  const denominator = expenseLoad + periodProfit;
  return denominator ? (expenseLoad / denominator) * 100 : null;
}

