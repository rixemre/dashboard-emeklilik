function formatBn(value) {
  if (value === null || value === undefined || !Number.isFinite(Number(value))) return 'n/a';
  const number = Number(value);
  const abs = Math.abs(number);
  const fmt = (num, digits) => num.toLocaleString('tr-TR', { minimumFractionDigits: digits, maximumFractionDigits: digits });
  const accounting = (text) => number < 0 ? `(${text})` : text;
  if (abs === 0) return '0 mio TL';
  if (abs >= 1000) {
    const scaled = abs / 1000;
    return accounting(`${fmt(scaled, scaled < 10 ? 2 : 1)} tri TL`);
  }
  if (abs >= 1) {
    return accounting(`${fmt(abs, abs < 10 ? 2 : 1)} mia TL`);
  }
  const million = abs * 1000;
  return accounting(`${fmt(million, million > 0 && million < 10 ? 1 : 0)} mio TL`);
}

function formatPct(value) {
  if (value === null || value === undefined || !Number.isFinite(Number(value))) return 'n/a';
  const number = Number(value);
  const text = `${Math.abs(number).toLocaleString('tr-TR', { minimumFractionDigits: 1, maximumFractionDigits: 1 })}%`;
  return number < 0 ? `(${text})` : text;
}

function formatRatio(value) {
  if (value === null || value === undefined || !Number.isFinite(Number(value))) return 'n/a';
  const number = Number(value);
  const text = Math.abs(number).toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  return number < 0 ? `(${text})` : text;
}

