function renderLifeTab() {
  const selected = companyMap[STATE.selectedCompany] || companies[0];
  const rankedByLifePremiums = sortBy(companies, (item) => item.lifePremiums);
  const rankedByLifeTech = sortBy(companies, (item) => item.lifeTech);
  const selectedChannel = channelBreakdown[selected.company] || { center: 0, agency: 0, bank: 0, broker: 0, other: 0, gross: 0, centerShare: 0, agencyShare: 0, bankShare: 0, brokerShare: 0, otherShare: 0 };
  const selectedChannelData = [
    { label: 'Banka', value: selectedChannel.bank, share: selectedChannel.bankShare, color: '#0f766e' },
    { label: 'Acente', value: selectedChannel.agency, share: selectedChannel.agencyShare, color: '#2563eb' },
    { label: 'Merkez', value: selectedChannel.center, share: selectedChannel.centerShare, color: '#0f172a' },
    { label: 'Broker', value: selectedChannel.broker, share: selectedChannel.brokerShare, color: '#d97706' },
    { label: 'Diğer', value: selectedChannel.other, share: selectedChannel.otherShare, color: '#e11d48' }
  ];
  const selectedCommission = commissionBreakdown[selected.company] || { total: 0, bank: 0, agency: 0, direct: 0, other: 0 };
  const selectedCommissionData = [
    { label: 'Banka', value: -n(selectedCommission.bank), share: 0, color: '#0f766e' },
    { label: 'Acente', value: -n(selectedCommission.agency), share: 0, color: '#2563eb' },
    { label: 'Doğrudan satış', value: -n(selectedCommission.direct), share: 0, color: '#d97706' },
    { label: 'Diğer', value: -n(selectedCommission.other), share: 0, color: '#e11d48' }
  ];
  const totalCommissionAbs = sum(selectedCommissionData, (item) => Math.abs(item.value));
  selectedCommissionData.forEach((item) => { item.share = totalCommissionAbs ? (Math.abs(item.value) / totalCommissionAbs) * 100 : 0; });
  const commentary = lifeSelectedCommentary(selected);

  const premiumChannelRows = sortBy(companies.map((item) => {
    const channel = channelBreakdown[item.company] || { center: 0, agency: 0, bank: 0, broker: 0, other: 0, gross: 0, centerShare: 0, agencyShare: 0, bankShare: 0, brokerShare: 0, otherShare: 0 };
    return {
      company: item.company,
      label: item.label,
      bank: channel.bank,
      agency: channel.agency,
      combinedOther: n(channel.center) + n(channel.broker) + n(channel.other),
      gross: channel.gross,
      bankShare: channel.bankShare,
      agencyShare: channel.agencyShare,
      combinedOtherShare: n(channel.centerShare) + n(channel.brokerShare) + n(channel.otherShare)
    };
  }), (item) => item.gross);

  const commissionRows = premiumChannelRows.map((row) => {
    const commission = commissionBreakdown[row.company] || { total: 0, bank: 0, agency: 0, direct: 0, other: 0 };
    const combinedOther = n(commission.direct) + n(commission.other);
    const bankAbs = Math.abs(n(commission.bank));
    const agencyAbs = Math.abs(n(commission.agency));
    const otherAbs = Math.abs(combinedOther);
    const totalAbs = bankAbs + agencyAbs + otherAbs;
    return {
      ...row,
      bankCommission: -n(commission.bank),
      agencyCommission: -n(commission.agency),
      combinedOtherCommission: -combinedOther,
      totalCommission: -n(commission.total),
      bankShare: totalAbs ? (bankAbs / totalAbs) * 100 : 0,
      agencyShare: totalAbs ? (agencyAbs / totalAbs) * 100 : 0,
      combinedOtherShare: totalAbs ? (otherAbs / totalAbs) * 100 : 0,
      totalShare: totalAbs ? 100 : 0,
      rawCommission: commission
    };
  });

  const ratioRows = premiumChannelRows.map((row) => {
    const commission = commissionBreakdown[row.company] || { total: 0, bank: 0, agency: 0, direct: 0, other: 0 };
    const premiumOther = n(channelBreakdown[row.company]?.center) + n(channelBreakdown[row.company]?.broker) + n(channelBreakdown[row.company]?.other);
    const commissionOther = n(commission.direct) + n(commission.other);
    const ratio = (premium, comm) => premium ? (-(n(comm)) / n(premium)) * 100 : null;
    return {
      ...row,
      bankRatio: ratio(channelBreakdown[row.company]?.bank, commission.bank),
      agencyRatio: ratio(channelBreakdown[row.company]?.agency, commission.agency),
      otherRatio: ratio(premiumOther, commissionOther),
      totalRatio: ratio(channelBreakdown[row.company]?.gross, commission.total)
    };
  });

  const totalsPremium = {
    bank: round(sum(premiumChannelRows, (item) => item.bank), 3),
    agency: round(sum(premiumChannelRows, (item) => item.agency), 3),
    combinedOther: round(sum(premiumChannelRows, (item) => item.combinedOther), 3),
    gross: round(sum(premiumChannelRows, (item) => item.gross), 3)
  };
  totalsPremium.bankShare = totalsPremium.gross ? (totalsPremium.bank / totalsPremium.gross) * 100 : 0;
  totalsPremium.agencyShare = totalsPremium.gross ? (totalsPremium.agency / totalsPremium.gross) * 100 : 0;
  totalsPremium.combinedOtherShare = totalsPremium.gross ? (totalsPremium.combinedOther / totalsPremium.gross) * 100 : 0;

  const totalsCommission = {
    bank: round(sum(commissionRows, (item) => item.bankCommission), 3),
    agency: round(sum(commissionRows, (item) => item.agencyCommission), 3),
    combinedOther: round(sum(commissionRows, (item) => item.combinedOtherCommission), 3),
    total: round(sum(commissionRows, (item) => item.totalCommission), 3)
  };
  const totalCommissionTableAbs = Math.abs(totalsCommission.bank) + Math.abs(totalsCommission.agency) + Math.abs(totalsCommission.combinedOther);
  totalsCommission.bankShare = totalCommissionTableAbs ? (Math.abs(totalsCommission.bank) / totalCommissionTableAbs) * 100 : 0;
  totalsCommission.agencyShare = totalCommissionTableAbs ? (Math.abs(totalsCommission.agency) / totalCommissionTableAbs) * 100 : 0;
  totalsCommission.combinedOtherShare = totalCommissionTableAbs ? (Math.abs(totalsCommission.combinedOther) / totalCommissionTableAbs) * 100 : 0;
  totalsCommission.totalShare = totalCommissionTableAbs ? 100 : 0;

  const ratio = (premium, commission) => premium ? (-(n(commission)) / n(premium)) * 100 : null;
  const ratioTotals = {
    bank: ratio(totalsPremium.bank, -totalsCommission.bank),
    agency: ratio(totalsPremium.agency, -totalsCommission.agency),
    other: ratio(totalsPremium.combinedOther, -totalsCommission.combinedOther),
    total: ratio(totalsPremium.gross, -totalsCommission.total)
  };

  const kpis = [
    metricCard('Hayat brüt primi', formatBn(sum(companies, (item) => item.lifePremiums)), 'Toplam üretim', 'slate'),
    metricCard('Hayat teknik kâr', formatBn(overview.lifeTech), 'Hayat branşı teknik sonucu', 'blue'),
    metricCard('Lider şirket', rankedByLifePremiums[0].label, formatBn(rankedByLifePremiums[0].lifePremiums), 'white'),
    metricCard('Negatif teknik sonuç', String(companies.filter((item) => n(item.lifeTech) < 0).length), 'Şirket sayısı', 'amber')
  ].join('');

  return `
    <div class="grid metrics-grid four">${kpis}</div>
    <div class="grid two-col">
      ${sectionCard('Hayat brüt prim liderleri', 'Brüt prim üretimine göre tüm şirketler.', renderBarList(rankedByLifePremiums.map((item) => ({ ...item, value: item.lifePremiums }))))}
      ${sectionCard('Hayat teknik kâr liderleri', 'Teknik sonuç kalitesine göre tüm şirketler.', renderBarList(rankedByLifeTech.map((item) => ({ ...item, value: item.lifeTech }))))}
    </div>
    <section class="card">
      <div class="section-head"><div><h2>Seçili şirket analizi</h2><p>Hayat üretimi, kanal dağılımı ve üretim komisyon giderleri.</p></div></div>
      ${companyPicker(companies, selected.company)}
      ${selectedHeader(selected, getStatus(selected), 'Hayat sekmesindeki tüm kartlar aynı seçili şirket için güncellenir.')}
      <div class="grid metrics-grid four mt-16">
        ${renderMiniMetric('Hayat brüt primi', formatBn(selected.lifePremiums), 'slate')}
        ${renderMiniMetric('Hayat teknik kâr', formatBn(selected.lifeTech), n(selected.lifeTech) < 0 ? 'rose' : 'blue')}
        ${renderMiniMetric('Toplam pay', formatPct(commentary.share), 'emerald')}
        ${renderMiniMetric('Teknik kâr / prim', formatPct(commentary.margin), commentary.margin < 0 ? 'rose' : 'slate')}
      </div>
      <div class="grid two-col mt-16">
        ${sectionCard('Kanal kırılımında hayat brüt primi', 'Seçili şirketin satış kanalı bazında üretim yapısı.', `
          ${renderBarList(selectedChannelData.map((item) => ({ ...item, subtitle: `Pay: ${formatPct(item.share)}` })), { valueKey: 'value', subtitleKey: 'subtitle', compact: true })}
        `, 'inner-card')}
        ${sectionCard('Üretim komisyon giderleri', 'Tutarlar ters işaretli gösterilir.', `
          ${renderBarList(selectedCommissionData.map((item) => ({ ...item, subtitle: `Pay: ${formatPct(item.share)}` })), { valueKey: 'value', subtitleKey: 'subtitle', compact: true })}
        `, 'inner-card')}
      </div>
      <div class="grid two-col mt-16">
        ${renderSignals('Güçlü taraflar', commentary.positives, 'emerald')}
        ${renderSignals('İzlenecek alanlar', commentary.risks, 'rose')}
      </div>
    </section>
    <div class="grid two-col">
      <section class="card">
