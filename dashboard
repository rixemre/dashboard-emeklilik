      const totalExpenseLoad = sum(expenseCompanies, (item) => item.expenseLoad);
      const totalPeriodProfit = sum(expenseCompanies, (item) => item.periodProfit);
      return totalExpenseLoad + totalPeriodProfit ? round((totalExpenseLoad / (totalExpenseLoad + totalPeriodProfit)) * 100, 1) : 0;
    })(),
    sectorExpenseToNetIncome: (() => {
      const totalExpenseLoad = sum(expenseCompanies, (item) => item.expenseLoad);
      const totalNetIncome = sum(expenseCompanies, (item) => item.netIncome);
      return totalNetIncome ? round((totalExpenseLoad / totalNetIncome) * 100, 1) : 0;
    })()
  };

  const comparisonTotals = {
    netIncome2025: round(sum(comparisonNetIncomeRows, (item) => item.netIncome2025), 3),
    netIncome2026: round(sum(comparisonNetIncomeRows, (item) => item.netIncome2026), 3)
  };
  comparisonTotals.change = round(comparisonTotals.netIncome2026 - comparisonTotals.netIncome2025, 3);
  comparisonTotals.changePct = comparisonTotals.netIncome2025 ? round((comparisonTotals.change / Math.abs(comparisonTotals.netIncome2025)) * 100, 1) : null;

