    'Allianz Yaşam ve Emeklilik AŞ'
  ];
  const available = new Set(comparisonNetIncomeRows.map((item) => item.company));
  return preferred.filter((company) => available.has(company));
}

function ensureComparisonSelection() {
  if (!Array.isArray(STATE.comparisonSelectedCompanies)) {
    STATE.comparisonSelectedCompanies = getComparisonDefaultSelection();
  }
  return STATE.comparisonSelectedCompanies;
}

function getComparisonSelectedRows() {
  const selected = new Set(ensureComparisonSelection());
  return getComparisonRowsSorted().filter((item) => selected.has(item.company));
}

function getComparisonSelectedTableRows(rows) {
  const mode = STATE.comparisonTableSortMode || 'default';
  if (mode === 'default') return [...rows];
  const config = {
    changeDesc: { key: 'change', direction: 'desc' },
    changeAsc: { key: 'change', direction: 'asc' },
    pctDesc: { key: 'changePct', direction: 'desc' },
    pctAsc: { key: 'changePct', direction: 'asc' }
  }[mode];
  if (!config) return [...rows];
  return [...rows].sort((a, b) => {
    const av = a[config.key];
    const bv = b[config.key];
    const aMissing = !hasComparableValue(av);
    const bMissing = !hasComparableValue(bv);
    if (aMissing !== bMissing) return aMissing ? 1 : -1;
    if (aMissing && bMissing) return a.label.localeCompare(b.label, 'tr');
    const diff = Number(av) - Number(bv);
    return config.direction === 'asc' ? diff : -diff;
  });
}

function setComparisonTableSortMode(mode) {
  STATE.comparisonTableSortMode = mode || 'default';
}

function setComparisonSelection(nextCompanies) {
  STATE.comparisonSelectedCompanies = Array.from(new Set(nextCompanies));
}

function toggleComparisonCompany(company) {
  const selected = new Set(ensureComparisonSelection());
  if (selected.has(company)) selected.delete(company);
  else selected.add(company);
  setComparisonSelection([...selected]);
}

function handleComparisonAction(action) {
  const rows = getComparisonRowsSorted();
  if (action === 'all') setComparisonSelection(rows.map((item) => item.company));
  if (action === 'none') setComparisonSelection([]);
  if (action === 'top8') setComparisonSelection(getComparisonDefaultSelection());
  if (action === 'common') setComparisonSelection(rows.filter((item) => item.availability === 'both').map((item) => item.company));
  if (action === 'missing') setComparisonSelection(rows.filter((item) => item.availability !== 'both').map((item) => item.company));
}

function comparisonCostIncomeForRows(rows, year) {
  const parts = rows
    .map((row) => getComparisonCostIncomeParts(row.company, year))
    .filter(Boolean);
  const expenseLoad = sum(parts, (item) => Math.abs(n(item.expenseLoad)));
  const periodProfit = sum(parts, (item) => item.periodProfit);
  return calcCostIncomeRatioFromParts({ expenseLoad, periodProfit });
}

function comparisonRoeForRows(rows, year) {
  const netIncome = sum(rows, (row) => year === '2025' ? row.netIncome2025 : row.netIncome2026);
  const equity = sum(rows, (row) => year === '2025' ? row.equity2025 : row.equity2026);
  return equity ? (netIncome / equity) * 100 : null;
}

function comparisonTotalsFor(rows) {
  const netIncome2025 = round(sum(rows, (item) => item.netIncome2025), 3);
  const netIncome2026 = round(sum(rows, (item) => item.netIncome2026), 3);
  const change = round(netIncome2026 - netIncome2025, 3);
  const changePct = netIncome2025 ? round((change / Math.abs(netIncome2025)) * 100, 1) : null;
  const costIncome2025 = comparisonCostIncomeForRows(rows, '2025');
  const costIncome2026 = comparisonCostIncomeForRows(rows, '2026');
  const costIncomeChange = hasComparableValue(costIncome2025) && hasComparableValue(costIncome2026) ? round(costIncome2026 - costIncome2025, 1) : null;
  const roe2025 = comparisonRoeForRows(rows, '2025');
  const roe2026 = comparisonRoeForRows(rows, '2026');
  return { netIncome2025, netIncome2026, change, changePct, costIncome2025, costIncome2026, costIncomeChange, roe2025, roe2026 };
}

