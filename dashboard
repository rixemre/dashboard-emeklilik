  const rankedByLifeTech = sortBy(companies, (item) => item.lifeTech || 0);
  const premiumRank = rankedByLifePremiums.findIndex((item) => item.company === selected.company) + 1;
  const techRank = rankedByLifeTech.findIndex((item) => item.company === selected.company) + 1;
  const share = totalLifePremiums ? (n(selected.lifePremiums) / totalLifePremiums) * 100 : 0;
  const margin = n(selected.lifePremiums) ? (n(selected.lifeTech) / n(selected.lifePremiums)) * 100 : 0;

  if (premiumRank > 0 && premiumRank <= 5) positives.push(`Hayat brüt priminde ${premiumRank}. sırada.`);
  if (n(selected.lifeTech) > 0) positives.push(`Hayat teknik sonuç pozitif: ${formatBn(selected.lifeTech)}.`);
  if (techRank > 0 && techRank <= 5) positives.push(`Hayat teknik kâr sıralamasında ${techRank}. sırada.`);
  if (margin >= 20) positives.push(`Teknik kâr / brüt prim oranı yüksek: ${formatPct(margin)}.`);
  if (share >= 10) positives.push(`Toplam hayat brüt primi içindeki pay güçlü: ${formatPct(share)}.`);

  if (n(selected.lifeTech) < 0) risks.push(`Hayat teknik zarar var: ${formatBn(selected.lifeTech)}.`);
  if (margin < 5) risks.push(`Teknik kâr / brüt prim marjı sınırlı: ${formatPct(margin)}.`);
  if (share < 2) risks.push(`Toplam hayat primi içindeki pay sınırlı: ${formatPct(share)}.`);
  if (n(selected.lifePremiums) < 1) risks.push('Hayat brüt prim ölçeği 1 mia TL altında.');

  if (!positives.length) positives.push('Hayat üretimi var ancak belirgin güçlü sinyal sınırlı.');
  if (!risks.length) risks.push('Hayat sekmesi özelinde belirgin kırmızı bayrak görünmüyor.');

  return { positives, risks, share, margin };
}

