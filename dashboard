function renderComparisonSvg(rows) {
  if (!rows.length) {
    return `<div class="comparison-empty"><div><strong>Grafik için şirket seç</strong><span>Aşağıdaki şirketlerden seçim yap.</span></div></div>`;
  }

  const width = Math.max(1080, 180 + rows.length * 172);
  const height = 500;
  const left = 86;
  const right = 44;
  const top = 96;
  const bottom = 82;
  const chartWidth = width - left - right;
  const chartHeight = height - top - bottom;
  const values = rows.flatMap((row) => [row.netIncome2025, row.netIncome2026].filter(hasComparableValue).map(Number));
  const rawMin = Math.min(0, ...values);
  const rawMax = Math.max(0, ...values);
  const span = rawMax - rawMin || 1;
  const min = rawMin < 0 ? rawMin - span * 0.18 : 0;
  const max = rawMax + span * 0.22;
  const y = (value) => top + ((max - Number(value)) / (max - min || 1)) * chartHeight;
  const zeroY = y(0);
  const groupWidth = chartWidth / rows.length;
  const barWidth = Math.max(22, Math.min(34, groupWidth * 0.20));
  const barGap = Math.max(14, Math.min(22, groupWidth * 0.13));
  const ticks = Array.from({ length: 5 }, (_, index) => min + ((max - min) * index) / 4);
  const grid = ticks.map((tick) => {
    const ty = y(tick);
    return `
      <line x1="${left}" y1="${ty}" x2="${width - right}" y2="${ty}" class="svg-grid" />
      <text x="${left - 14}" y="${ty + 4}" text-anchor="end" class="svg-axis-label">${escapeHtml(formatBn(tick))}</text>
    `;
  }).join('');
  const clipLabel = (label) => label.length > 17 ? `${label.slice(0, 16)}…` : label;
  const deltaTone = (row) => row.availability !== 'both' ? '#d97706' : (n(row.change) < 0 ? '#be123c' : '#059669');
  const changeMeta = (row) => row.availability === 'both'
    ? `Değişim: ${formatSignedBn(row.change)} · ${formatSignedPct(row.changePct)}`
    : row.statusLabel;

  const renderBar = (row, value, centerX, fill, label) => {
    const tooltipTitle = `${row.label} · ${label}`;
    if (!hasComparableValue(value)) {
      const missingText = label === '2025' ? '2025 yok' : '2026 yok';
      return `
        <g class="svg-bar-hover" data-comparison-tooltip="1" data-tooltip-title="${escapeHtml(tooltipTitle)}" data-tooltip-value="${escapeHtml(missingText)}" data-tooltip-meta="${escapeHtml(row.statusLabel)}">
          <rect class="svg-hit" x="${centerX - barWidth / 2 - 12}" y="${Math.max(top + 20, zeroY - 48)}" width="${barWidth + 24}" height="64" rx="17" fill="#ffffff" opacity="0" pointer-events="all" />
          <line x1="${centerX - barWidth / 2}" y1="${zeroY}" x2="${centerX + barWidth / 2}" y2="${zeroY}" stroke="#fbbf24" stroke-width="5" stroke-linecap="round" stroke-dasharray="2 8" />
          <text x="${centerX}" y="${Math.max(top + 20, zeroY - 13)}" text-anchor="middle" class="svg-missing-mini">Yok</text>
        </g>
      `;
    }
    const valueY = y(value);
    const barY = Math.min(valueY, zeroY);
    const barHeight = Math.max(5, Math.abs(zeroY - valueY));
    return `
      <g class="svg-bar-hover" data-comparison-tooltip="1" data-tooltip-title="${escapeHtml(tooltipTitle)}" data-tooltip-value="${escapeHtml(formatBn(value))}" data-tooltip-meta="${escapeHtml(changeMeta(row))}">
        <rect class="svg-hit" x="${centerX - barWidth / 2 - 12}" y="${Math.max(top, barY - 14)}" width="${barWidth + 24}" height="${barHeight + 28}" rx="17" fill="#ffffff" opacity="0" pointer-events="all" />
        <rect class="svg-bar" x="${centerX - barWidth / 2}" y="${barY}" width="${barWidth}" height="${barHeight}" rx="12" fill="${fill}" />
      </g>
    `;
  };

  const body = rows.map((row, index) => {
    const groupX = left + groupWidth * index + groupWidth / 2;
    const x2025 = groupX - (barWidth / 2 + barGap / 2);
    const x2026 = groupX + (barWidth / 2 + barGap / 2);
    const color = getCompanyColor(row.company);
    const gradId = `grad2026-${index}`;
    const panelX = groupX - groupWidth / 2 + 10;
    const panelW = groupWidth - 20;
    const deltaPctText = row.availability === 'both' ? formatSignedPct(row.changePct) : (row.availability === 'only2025' ? '2026 yok' : '2025 yok');
    const deltaAbsText = row.availability === 'both' ? formatSignedBn(row.change) : row.statusLabel;
    const tone = deltaTone(row);
    const pillW = Math.max(78, Math.min(116, 44 + deltaPctText.length * 7));
    const both = row.availability === 'both' && hasComparableValue(row.netIncome2025) && hasComparableValue(row.netIncome2026);
    const linePath = '';
    return `
      <defs>
        <linearGradient id="${gradId}" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="${color}" />
          <stop offset="100%" stop-color="#1e1b4b" />
        </linearGradient>
      </defs>
      <g>
        <rect class="svg-company-panel ${index % 2 ? 'alt' : ''}" x="${panelX}" y="${top - 58}" width="${panelW}" height="${chartHeight + 122}" rx="26" />
        <rect x="${groupX - pillW / 2}" y="22" width="${pillW}" height="31" rx="16" fill="${tone}" opacity="0.96" />
        <text x="${groupX}" y="42" text-anchor="middle" class="svg-delta-text">${escapeHtml(deltaPctText)}</text>
        <text x="${groupX}" y="68" text-anchor="middle" class="svg-delta-subtext">${escapeHtml(deltaAbsText)}</text>
        ${linePath}
        ${renderBar(row, row.netIncome2025, x2025, 'url(#grad2025)', '2025')}
        ${renderBar(row, row.netIncome2026, x2026, `url(#${gradId})`, '2026')}
        <text x="${x2025}" y="${height - 50}" text-anchor="middle" class="svg-year-label">2025</text>
        <text x="${x2026}" y="${height - 50}" text-anchor="middle" class="svg-year-label">2026</text>
        <text x="${groupX}" y="${height - 26}" text-anchor="middle" class="svg-company-label-mini">${escapeHtml(clipLabel(row.label))}</text>
      </g>
    `;
  }).join('');

  return `
    <div class="comparison-chart-scroll">
      <svg class="comparison-svg" viewBox="0 0 ${width} ${height}" role="img" aria-label="Net kâr 2025 2026 ve yüzde değişim grafiği">
        <defs>
          <linearGradient id="premiumChartBg" x1="0" x2="1" y1="0" y2="1">
            <stop offset="0%" stop-color="#ffffff" />
            <stop offset="54%" stop-color="#f4f8ff" />
            <stop offset="100%" stop-color="#eaf2ff" />
          </linearGradient>
          <linearGradient id="grad2025" x1="0" x2="0" y1="0" y2="1">
            <stop offset="0%" stop-color="#cbd5e1" />
            <stop offset="100%" stop-color="#475569" />
          </linearGradient>
        </defs>
        <rect x="0" y="0" width="${width}" height="${height}" rx="30" fill="url(#premiumChartBg)" />
        <circle cx="${width - 105}" cy="70" r="145" fill="rgba(37,99,235,0.075)" />
        <circle cx="125" cy="${height - 80}" r="125" fill="rgba(14,165,233,0.065)" />
        ${grid}
        <line x1="${left}" y1="${zeroY}" x2="${width - right}" y2="${zeroY}" class="svg-zero" />
        ${body}
      </svg>
    </div>
  `;
}

function lifeSelectedCommentary(selected) {
  const positives = [];
  const risks = [];
  const totalLifePremiums = sum(companies, (item) => item.lifePremiums || 0);
